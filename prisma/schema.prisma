generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BatchStatus {
  NEW
  IN_PRODUCTION
  AWAITING_ACCEPTANCE
  ACCEPTED
  SHIPPED
}

enum AssignmentStatus {
  IN_PROGRESS
  COMPLETED
  RETURNED
}

enum MovementType {
  IN
  OUT
}

enum MaterialUnit {
  KG
  METR
}

model User {
  id Int @id @default(autoincrement())

  fullName    String?    @db.VarChar(100)
  email       String     @unique @db.VarChar(254)
  password    String
  role        Role
  status      UserStatus @default(INACTIVE)
  hourlyPrice Decimal?   @db.Decimal(12, 2)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt 

  attendances         Attendance[]     @relation("UserAttendances")
  updatedAttendances  Attendance[]     @relation("SuperAdminAttendanceUpdates")
  workAssignments     WorkAssignment[]
}

model Attendance {
  id          Int       @id @default(autoincrement())
  userId      Int
  checkIn     DateTime  @default(now())
  checkOut    DateTime?
  totalHours  Decimal?  @db.Decimal(5, 2)
  updatedById Int?      

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy   User?     @relation("SuperAdminAttendanceUpdates", fields: [updatedById], references: [id])
}

model ProductModel {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  sku       String   @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modelOperations ModelOperation[]
  orders          Order[]
}

model Operation {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modelOperations ModelOperation[]
}

model ModelOperation {
  id          Int      @id @default(autoincrement())
  modelId     Int
  operationId Int
  stepOrder   Int      
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productModel ProductModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  operation    Operation        @relation(fields: [operationId], references: [id], onDelete: Cascade)
  assignments  WorkAssignment[]

  @@unique([modelId, operationId])
  @@unique([modelId, stepOrder])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int
  modelId    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id])
  productModel ProductModel @relation(fields: [modelId], references: [id])
  orderBatches OrderBatch[]
}

model OrderBatch {
  id            Int         @id @default(autoincrement())
  orderId       Int
  batchNumber   Int         @unique @default(autoincrement()) 
  color         String      @db.VarChar(50)
  size          String      @db.VarChar(30)
  totalQuantity Int
  status        BatchStatus @default(NEW)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workAssignments WorkAssignment[]
}

model WorkAssignment {
  id               Int              @id @default(autoincrement())
  userId           Int              
  orderBatchId     Int
  modelOperationId Int
  quantityAssigned Int
  status           AssignmentStatus @default(IN_PROGRESS)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  orderBatch     OrderBatch     @relation(fields: [orderBatchId], references: [id])
  modelOperation ModelOperation @relation(fields: [modelOperationId], references: [id])
}

model Material {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  unit           MaterialUnit 
  currentBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventoryMovements InventoryMovement[]
}

model InventoryMovement {
  id         Int          @id @default(autoincrement())
  materialId Int
  type       MovementType
  quantity   Decimal      @db.Decimal(12, 2)
  reason     String?      @db.VarChar(255)
  createdAt  DateTime     @default(now())

  material   Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
}
