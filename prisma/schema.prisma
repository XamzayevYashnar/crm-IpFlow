generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum PermissionAction {
  CREATE_USER
  READ_USER
  UPDATE_USER
  DELETE_USER
  MANAGE_ROLES
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BatchStatus {
  NEW
  IN_PRODUCTION
  AWAITING_ACCEPTANCE
  ACCEPTED
  SHIPPED
}

enum AssignmentStatus {
  IN_PROGRESS
  COMPLETED
  RETURNED
}

enum MovementType {
  IN
  OUT
}

enum MaterialUnit {
  KG
  METR
}

enum PayType {
  HOURLY
  PIECE_RATE
}

model User {
  id                  Int              @id @default(autoincrement())
  email               String?           @unique @db.VarChar(254)
  password            String?
  phone               String?          @unique @db.VarChar(20)
  pinCode             String?
  pinLookup           String?          @unique
  fullName            String?          @db.VarChar(100)
  avatar              String?
  roleId              Int
  role                UserRole         @relation(fields: [roleId], references: [id])
  status              UserStatus       @default(INACTIVE)
  payType             PayType          @default(HOURLY)
  hourlyPrice         Decimal?         @db.Decimal(12, 2)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  attendances         Attendance[]     @relation("UserAttendances")
  updatedAttendances  Attendance[]     @relation("SuperAdminAttendanceUpdates")
  workAssignments     WorkAssignment[]
  payments            Payment[]
}

model UserRole {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  users       User[]
  permissions Permission[]
}

model Permission {
  id      Int              @id @default(autoincrement())
  action  PermissionAction @unique
  roles   UserRole[]
}

model Attendance {
  id          Int       @id @default(autoincrement())
  userId      Int
  checkIn     DateTime  @default(now())
  checkOut    DateTime?
  totalHours  Decimal?  @db.Decimal(5, 2)
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy   User?     @relation("SuperAdminAttendanceUpdates", fields: [updatedById], references: [id])
}

model ProductModel {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  sku             String           @unique @db.VarChar(50)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  modelOperations ModelOperation[]
  orders          Order[]
  modelMaterials  ModelMaterial[]
}

model Operation {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  modelOperations ModelOperation[]
}

model ModelOperation {
  id           Int              @id @default(autoincrement())
  modelId      Int
  operationId  Int
  pricePerUnit Decimal?         @db.Decimal(12,2) 
  stepOrder    Int
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  productModel ProductModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  operation    Operation        @relation(fields: [operationId], references: [id], onDelete: Cascade)
  assignments  WorkAssignment[]

  @@unique([modelId, operationId])
  @@unique([modelId, stepOrder])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id           Int          @id @default(autoincrement())
  customerId   Int?
  modelId      Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customer     Customer?    @relation(fields: [customerId], references: [id])
  productModel ProductModel @relation(fields: [modelId], references: [id])
  orderBatches OrderBatch[]
}

model Color {
  id      Int          @id @default(autoincrement())
  name    String       @unique @db.VarChar(50)
  batches OrderBatch[]
}

model Size {
  id      Int          @id @default(autoincrement())
  name    String       @unique @db.VarChar(30)
  batches OrderBatch[]
}

model OrderBatch {
  id              Int              @id @default(autoincrement())
  orderId         Int
  batchNumber     Int              @unique @default(autoincrement())
  colorId         Int
  sizeId          Int
  totalQuantity   Int
  status          BatchStatus      @default(NEW)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  color           Color            @relation(fields: [colorId], references: [id])
  size            Size             @relation(fields: [sizeId], references: [id])
  workAssignments WorkAssignment[]
}

model WorkAssignment {
  id               Int              @id @default(autoincrement())
  userId           Int
  orderBatchId     Int
  modelOperationId Int
  quantityAssigned Int
  status           AssignmentStatus @default(IN_PROGRESS)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id])
  orderBatch       OrderBatch       @relation(fields: [orderBatchId], references: [id])
  modelOperation   ModelOperation   @relation(fields: [modelOperationId], references: [id])
}

model Material {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(100)
  unit               MaterialUnit
  currentBalance     Decimal             @default(0.00) @db.Decimal(12, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  modelMaterials     ModelMaterial[]
}

model InventoryMovement {
  id         Int          @id @default(autoincrement())
  materialId Int
  type       MovementType
  quantity   Decimal      @db.Decimal(12, 2)
  reason     String?      @db.VarChar(255)
  createdAt  DateTime     @default(now())
  material   Material     @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

model ModelMaterial {
  id             Int          @id @default(autoincrement())
  materialId     Int
  productId      Int
  quantityNeeded Decimal      @db.Decimal(12, 2)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  product        ProductModel @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId])
}
model Payment {
  id              Int       @id @default(autoincrement())
  userId          Int
  amount          Decimal   @db.Decimal(12,2)
  note            String?   @db.VarChar(255)
  paidAt          DateTime  @default(now())
  createdBy       Int?  
  user            User      @relation(fields:[userId], references: [id], onDelete: Cascade)
}